# .dockerignore
#
# Keeps the docker build context (platforms/docker/Dockerfile's `COPY . .`,
# invoked from the repo root) from shipping build artifacts, VCS history,
# and local-only machine configuration into the build.

.git/
target/
target-*/
node_modules/
.wrangler/
.xcode-build/
__pycache__/
*.pyc

# Local machine config / agent tooling -- never part of a container build.
.claude/
.codex/
.opencode/
.cargo/

# Docker/packaging output directories from other installers, not inputs.
platforms/*/package/dist/
platforms/*/package/.stage/
platforms/macos/package/.xcode-build/
