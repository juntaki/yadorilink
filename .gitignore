/target
# platforms/windows/shell and platforms/macos/app/*/core are separate Cargo
# workspaces (nested under this repo but not members of the root
# workspace, since they're platform-specific and don't build on every
# dev machine) — a non-anchored pattern catches their own target/ dirs
# too, not just the root one.
target/
# Parallel/isolated build directories (e.g. target-turmoil, per-lane dirs used
# to avoid build-dir contention across concurrent work) — same rationale as
# target/, never checked in.
target-*/
*.sqlite3
*.sqlite3-journal
.DS_Store

# Python bytecode cache for the CI check scripts.
__pycache__/
*.pyc

# Xcode build products (platforms/macos/app's FIFinderSync extension host app)
# Leading **/ needed: a pattern with a slash in the middle (not just at
# the end) is anchored to the .gitignore's own directory otherwise, so
# without it these never matched xcodeproj dirs nested under platforms/.
.build/
DerivedData/
**/*.xcodeproj/xcuserdata/
**/*.xcodeproj/project.xcworkspace/xcuserdata/
**/*.xcworkspace/xcuserdata/
**/*.xcworkspace/xcshareddata/

# Machine-specific cargo target-dir override (redirects build output to
# a volume with more free space) — not portable to other machines.
# Leading **/ needed for the same reason as the Xcode patterns above: a
# slash in the middle of the pattern otherwise anchors it to this
# .gitignore's own directory, so the platform integrations' nested Cargo workspaces
# (platforms/macos/app/*/core/.cargo/config.toml) never matched without it.
**/.cargo/config.toml

# platforms/macos/package/build-pkg.sh's scratch/output dirs (rebuilt from
# scratch on every run; the built .pkg is a local artifact, not checked
# in — see platforms/macos/package/README.md for how to build it).
platforms/macos/package/.stage/
platforms/macos/package/.xcode-build/
platforms/macos/package/dist/
platforms/macos/package/.component.plist
platforms/macos/package/.Distribution.generated.xml

# platforms/windows/package/yadorilink.iss's ISCC output dir (the built
# yadorilink-setup.exe is a local artifact, not checked in — see
# platforms/windows/package/README.md for how to build it).
platforms/windows/package/Output/

# platforms/linux/package/build-deb.sh's scratch/output dirs (rebuilt from
# scratch on every run; the built .deb is a local artifact, not checked
# in — see platforms/linux/package/README.md for how to build it).
platforms/linux/package/.stage/
platforms/linux/package/dist/

# platforms/linux/package/apt/build-keyring-deb.sh's scratch/output dirs — same
# rebuilt-from-scratch, not-checked-in shape as platforms/linux/package/.stage/
# and platforms/linux/package/dist/ above.
platforms/linux/package/apt/.stage/
platforms/linux/package/apt/dist/

# Generated per-release artifacts (.github/release/generate-release-checksums.py
# --out) — regenerated for each release from the actual build outputs, not
# checked in.
/release/

# Third-party license notice generated by .github/release/generate-third-party-licenses.sh
# (cargo-about). A build/packaging output bundled into release artifacts, not
# checked in.
/THIRD-PARTY-LICENSES.html

# The client core static library platforms/macos/generate-swift-bindings.sh builds
# for the macOS app; the generated Swift next to it is checked in.
platforms/macos/app/YadoriLinkApp/FFI/lib/
